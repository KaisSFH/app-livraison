<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Indicateur de glissement -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E2E8F0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/sheetClientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jean Dupont"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/sheetAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="123 Rue de la Liberté, Casablanca"
        android:textColor="@color/on_surface_variant"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Actions -->
    <Button
        android:id="@+id/btnStartDelivery"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Démarrer la livraison"
        android:backgroundTint="@color/primary"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnMarkDelivered"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Marquer comme Livré"
        android:backgroundTint="#10B981"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="En cas de problème"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface_variant"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUnreachable"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Injoignable"
            android:textSize="12sp"
            android:textColor="@color/error"
            app:strokeColor="@color/error"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnNotPaid"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Non payé"
            android:textSize="12sp"
            android:textColor="@color/error"
            app:strokeColor="@color/error"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCanceled"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Annulé"
            android:textSize="12sp"
            android:textColor="@color/error"
            app:strokeColor="@color/error"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
